# Copie para .env (fora do git) e preencha. Valores abaixo são só exemplos.
# Variáveis do app (e do compose/Traefik).
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
# Hostname público do sistema (sem https://)
APP_HOST=gestao.exemplo.com
# Traefik existente no servidor
TRAEFIK_NETWORK=n8n_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge
